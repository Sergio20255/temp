APP_NAME=FileForge
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=change-me
APP_TIMEZONE=UTC

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fileforge
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_QUEUE=conversions

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

MAX_UPLOAD_MB=100
FILE_RETENTION_HOURS=24
ENABLE_MALWARE_SCAN=true
DEFAULT_THEME=light
